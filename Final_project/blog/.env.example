# Copy to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL (local install — default host is localhost)
POSTGRES_DB=cheeseoo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production

# Wagtail admin URL (local dev)
WAGTAILADMIN_BASE_URL=http://127.0.0.1:8000

# Email (QQ SMTP — fill in .env, do not commit real passwords)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Agent LLM — default local Ollama keeps paywalled article snippets off third-party APIs
# Provider: ollama | openai
AGENT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
